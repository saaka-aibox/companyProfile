# --- server ---
PORT=3011
# Behind a reverse proxy set the number of trusted hops (1 = Caddy/nginx in front). 0 = use socket address.
TRUST_PROXY=0
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3001
APP_URL=http://localhost:3001
PUBLIC_HUB_URL=http://localhost:3011
DATA_DIR=./data

# --- payments ---
# mock | tripay
PAYMENT_MODE=mock
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_SANDBOX=true
TRIPAY_METHOD=QRIS

# --- storage ---
# local | r2
STORAGE=local
UPLOAD_MAX_BYTES=4194304
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# optional public/CDN base used for GET urls (no trailing slash)
R2_PUBLIC_BASE=

# --- AI (fal.ai). Empty FAL_KEY = mock mode (output = input) ---
FAL_KEY=
FAL_STYLE_ENDPOINT=fal-ai/flux-pro/kontext

# --- WebRTC TURN (optional, coturn static-auth-secret) ---
TURN_URLS=
TURN_SECRET=
